<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ScreenStream 24/7 Infinite"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Idle (Ready to Stream)"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Render Server WebSocket URL:"
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="wss://your-app.onrender.com/socket"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:backgroundTint="#38BDF8"
            android:inputType="textUri"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stream ID (Share this to watch):"
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/streamIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 998877"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:backgroundTint="#38BDF8"
            android:inputType="text"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stream Password / PIN (Optional):"
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Leave blank for no password"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:backgroundTint="#38BDF8"
            android:inputType="textPassword"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/startStopBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="START 24/7 STREAM"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Disable Battery Limit (Keep Alive)"
            android:backgroundTint="#334155"
            android:textColor="#E2E8F0"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/localUrlInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Paste your Render URL once (it saves automatically). Stream will NEVER auto-disconnect until you press STOP."
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
